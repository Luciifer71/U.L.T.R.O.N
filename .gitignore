client_secret*.json
credentials.json
token.json

# Generated frontend output
ultron-ui/dist/
*.tsbuildinfo

# Test output (keep test source files tracked)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml

# Local credentials and private material
credentials*.json
token*.json
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# User knowledge is local input, never a source-code fixture
/knowledge_base/

# Support archives and editor/OS debris
ultron-support-*.zip
ultron-acceptance-*.zip
.DS_Store
Thumbs.db

