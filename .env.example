# Optional local overrides. Copy to .env; never commit the real .env.
# Runtime defaults are supplied by the application. Leave this template free
# of account identifiers, credentials, machine-specific paths and private tuning.
# These loopback URLs are local development endpoints, not remote credentials.
OLLAMA_HOST=http://127.0.0.1:11434
NATS_URL=nats://127.0.0.1:4222

# Automatic microphone selection and supported speech-device fallback.
AUDIO_INPUT_MODE=auto
WHISPER_DEVICE=auto

# Optional camera presence: the entity notices when you sit down (off unless 1).
# Only face position numbers leave the camera process; no images. See docs/camera-presence.md.
# ULTRON_PRESENCE=1

# Hand gestures: a double clap toggles gesture mode (opens the camera). Set 0 to
# disable clap detection; voice and the Ops panel still work. See docs/gestures.md.
# ULTRON_CLAP=0

# Camera size for hand tracking (default 1280x720; 16:9 avoids side cropping).
# ULTRON_GESTURE_RESOLUTION=1280x720

# Add any model, language or hardware overrides only to your local .env.
# Google credentials belong in the account connection flow, not this file.
