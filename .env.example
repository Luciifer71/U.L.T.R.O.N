# ===================================
# ULTRON-AI SYSTEM CONFIGURATION
# ===================================

# --- Ollama Core ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
# Default Qwen3 profile. Explicit environment settings remain authoritative.
LLM_THINKING=off
LLM_CONTEXT=4096
LLM_TEMPERATURE=0
LLM_SEED=42

# --- NATS Event Mesh ---
NATS_URL=nats://127.0.0.1:4222

# --- Memory & Storage Paths ---
SQLITE_DB_PATH=ultron_memory.db
CHROMA_DB_PATH=./chroma_db

# --- Perception & Voice Settings ---
# voice_listener loads this project's .env; process variables take precedence.
WHISPER_MODEL_SIZE=small.en
# cuda requires a successful GPU probe; auto permits same-model CPU fallback.
WHISPER_DEVICE=auto
WHISPER_CUDA_COMPUTE_TYPE=float16
WHISPER_DEVICE_INDEX=0
WHISPER_LANGUAGE=en
WHISPER_STARTUP_TIMEOUT=300
WHISPER_LOCAL_FILES_ONLY=0
# WHISPER_DOWNLOAD_ROOT=C:\Models\Whisper
# Automatic mode ignores old device overrides; pinned requires an explicit device.
AUDIO_INPUT_MODE=auto
# AUDIO_INPUT_DEVICE=1
# ULTRON_CUDA_LIBRARY_DIRS=C:\CUDA\bin;C:\cuDNN\bin

# --- System Debugging ---
LOG_LEVEL=INFO
DEBUG=False
